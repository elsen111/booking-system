# Copy to .env and adjust: cp .env.example .env
# Plain KEY=value only. Do not wrap values in quotes (Spring reads this file in properties format).

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking
DB_USERNAME=booking
DB_PASSWORD=change-me

# --- Security ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me

# --- Bootstrap admin (created on first start if missing) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# --- Optional ---
# PORT=8080
# SPRING_PROFILES_ACTIVE=prod
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000